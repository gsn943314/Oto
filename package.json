{
  "name": "voice-input-app",
  "version": "1.1.0",
  "description": "A small macOS voice input app powered by OpenAI GPT Transcribe",
  "type": "module",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build:helper && concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:main && node scripts/start-electron.cjs",
    "build": "npm run build:icon && npm run build:helper && npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "node -e \"require('node:fs').rmSync('dist/main', {recursive:true,force:true})\" && tsc -p tsconfig.main.json && cp src/main/preload.cjs dist/main/main/preload.cjs",
    "build:icon": "bash scripts/build-icon.sh",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:mac:dir": "npm run build && electron-builder --mac --dir --publish never",
    "build:helper": "bash scripts/build-helper.sh",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "npm run build:main && env -u ELECTRON_RUN_AS_NODE electron tests/transcription.cjs"
  },
  "keywords": [
    "electron",
    "voice",
    "whisper",
    "speech-to-text"
  ],
  "author": "gsn943314",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.28.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "electron-store": "^8.1.0",
    "openai": "^4.20.1",
    "opencc-js": "^1.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.voiceinput.app",
    "productName": "Oto",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "11.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Oto records your voice to transcribe it using your OpenAI API account."
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "extraMetadata": {
      "main": "dist/main/main/main.js"
    },
    "extraResources": [
      {
        "from": "build/native",
        "to": "native",
        "filter": [
          "voiceinput-helper"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gsn943314/Oto.git"
  },
  "engines": {
    "node": ">=20"
  }
}
